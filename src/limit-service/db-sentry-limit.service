[Unit]
Description=dB-Sentry Limit Service
# Not ordered After= influxdb/mosquitto: starting in parallel lets our slow Python
# imports overlap their startup. main.py waits for InfluxDB and the MQTT client
# retries until the broker is up.
Wants=network.target mosquitto.service influxdb.service

[Service]
Type=simple
User=garth
Group=garth
WorkingDirectory=/home/garth/dB-Sentry/src/limit-service
Environment="PATH=/home/garth/dB-Sentry/src/limit-service/venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/garth/dB-Sentry/src/limit-service/venv/bin/python main.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
